<jasperReport name="report name" language="java" pageWidth="595" pageHeight="421" orientation="Landscape" whenNoDataType="NoPages" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="d6cdc85e-4576-4f47-9125-afa0f40f6130">
	<property name="ireport.zoom" value="1.9487171000000028"/>
	<property name="ireport.x" value="414"/>
	<property name="ireport.y" value="0"/>
	<parameter name="id_orden" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT matricula_colegiado, nombre_colegiado,fecha_orden,matricula_prescripcion,nombre_afiliado,numero_afiliado,numero_orden,
detalle_ordenes.cod_practica,nombre_practica,round(CAST(precio_practica as double),2) as precio_practica ,round(CAST(detalle_ordenes.coseguro as double),2) as coseguro,obrasocial.razonsocial_obrasocial,ordenes.coseguro as coseguro_orden
FROM ordenes
INNER JOIN detalle_ordenes using(id_orden) 
INNER JOIN obrasocial USING (id_obrasocial)
INNER JOIN colegiados USING (id_colegiados)
WHERE ordenes.id_orden=$P{id_orden}]]></query>
