	<parameter name="practicas" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT  ordenes.id_orden,obrasocial.razonsocial_obrasocial ,ordenes.numero_afiliado, ordenes.nombre_afiliado,ordenes.numero_orden,ordenes.fecha_orden
,colegiados.matricula_colegiado,SUM(detalle_ordenes.precio_practica) AS Total,if(ordenes.id_obrasocial=89,CAST(ordenes.coseguro as double),SUM(detalle_ordenes.coseguro)) as coseguro,
ordenes.estado_orden, ordenes.dni_afiliado,substring(ip,15,28) as ip , obrasocial.`codigo_obrasocial`
FROM colegiados
JOIN ordenes ON colegiados.id_colegiados = ordenes.id_colegiados
JOIN detalle_ordenes ON detalle_ordenes.id_orden = ordenes.id_orden
JOIN obrasocial ON obrasocial.id_obrasocial = ordenes.id_obrasocial
WHERE detalle_ordenes.estado=0 and ordenes.estado_orden!=0 AND colegiados.matricula_colegiado=$P{matricula} and periodo=$P{periodo} and obrasocial.`codigo_obrasocial`=$P{num_obra_social} 
GROUP BY ordenes.id_orden  order by ip,ordenes.id_orden]]>
	</queryString>
