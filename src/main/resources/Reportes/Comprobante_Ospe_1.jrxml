	<parameter name="id_orden" class="java.lang.Integer">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<query language="sql"><![CDATA[SELECT matricula_colegiado, nombre_colegiado,fecha_orden,matricula_prescripcion,nombre_afiliado,numero_afiliado,numero_orden,
detalle_ordenes.cod_practica,nombre_practica,round(CAST(precio_practica as double),2) as precio_practica ,round(CAST(ordenes.coseguro as double),2) as coseguro
FROM ordenes
INNER JOIN detalle_ordenes using(id_orden) 
INNER JOIN obrasocial USING (id_obrasocial)
INNER JOIN colegiados USING (id_colegiados)
WHERE ordenes.id_orden=$P{id_orden}]]></query>
