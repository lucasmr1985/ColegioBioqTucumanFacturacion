	<query language="sql"><![CDATA[Select codigo_practica,determinacion_practica,round(CAST(unidadbioquimica_practica as double),2) as unidadbioquimica_practica,abreviatura_practica,urgencia_practica,referencia_practica,fercuencia_practica
from practicasnbu
