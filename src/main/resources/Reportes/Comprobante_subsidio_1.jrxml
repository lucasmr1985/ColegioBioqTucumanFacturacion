<jasperReport name="report name" language="java" columnCount="1" pageWidth="595" pageHeight="421" orientation="Landscape" whenNoDataType="NoPages" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="14c0e9fd-9980-4088-a900-cb840ec52d21">
